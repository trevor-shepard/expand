# Copy values into your shell or process manager. Node does not load this file automatically.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Leave DATABASE_URL unset for the local fixture repository.
# DATABASE_URL=postgresql://user:password@localhost:5432/expand
# LEVEL_REPOSITORY=postgres
DATABASE_POOL_SIZE=10

# Generate unique values; never commit real credentials.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# ADMIN_COOKIE_SECURE=false
